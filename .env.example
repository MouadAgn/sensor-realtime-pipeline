# Modèle de configuration — copier en `.env` et renseigner.
#   cp .env.example .env
# Toutes les clés sont optionnelles : le docker-compose.yml a des valeurs par
# défaut (${VAR:-...}), donc un .env vide fonctionne. Remplir pour surcharger.

COMPOSE_PROJECT_NAME=

# --- Kafka ---
KAFKA_TOPIC=
KAFKA_PARTITIONS=

# --- Ports exposés sur l'hôte ---
KAFKA_EXTERNAL_PORT=
KAFKA_UI_PORT=
SPARK_MASTER_UI_PORT=
SPARK_WORKER_UI_PORT=
SPARK_APP_UI_PORT=
SPARK_MASTER_PORT=
POSTGRES_PORT=
METABASE_PORT=

# --- Postgres de service (serving layer lu par Metabase) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Ressources Spark worker ---
SPARK_WORKER_MEMORY=
SPARK_WORKER_CORES=

# --- Générateur ---
ANOMALY_RATE=
MIN_INTERVAL=
MAX_INTERVAL=
